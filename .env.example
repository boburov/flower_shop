# ----------------------------------------------------------------------------
# Bloomé — environment variables
# Copy to .env and fill in. NEVER commit real secrets. .env is gitignored.
# ----------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Pooled connection string (Neon "Pooled connection") — used by the app at runtime.
# Leave as the placeholder below to run WITHOUT a database (seed-data fallback).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct (non-pooled) connection — used only by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Telegram ----------------------------------------------------------------
# Public username customers message to place an order. Safe to expose.
NEXT_PUBLIC_TELEGRAM_USERNAME="boburov_sh"

# Bot token — SERVER-ONLY SECRET. Used by the admin bot (scripts/admin-bot.ts),
# the image proxy, and the image-import script.
# Never prefix with NEXT_PUBLIC_. Never commit a real value.
TELEGRAM_BOT_TOKEN=""

# Chat id(s) allowed to use the admin bot, comma-separated. Run the bot once with
# this empty — it replies with your chat id, then paste it here.
TELEGRAM_ADMIN_CHAT_ID=""

# Chat ID the import script uploads photos to (your own chat with the bot, or a
# private channel). Used only by the image-import script.
TELEGRAM_CHAT_ID=""

# Base URL of the Telegram Bot API. Leave empty to talk to api.telegram.org
# directly. Set it to a reverse proxy (e.g. a Cloudflare Worker, see
# cloudflare/README.md) only on hosts that cannot reach Telegram directly — the
# bot retries against api.telegram.org as a fallback either way.
TELEGRAM_API_BASE=""

# --- Cache revalidation ------------------------------------------------------
# Shared secret the admin bot uses to tell the website to refresh its cached
# catalogue pages after a change (POST /api/revalidate). Generate with
# `openssl rand -hex 32`. Leave empty to disable on-demand revalidation — pages
# then refresh on their own within a minute.
REVALIDATE_SECRET=""

# Where the bot can reach the website. Defaults to http://127.0.0.1:3000; set it
# to the port the site actually listens on, or to the public URL.
SITE_URL=""

# --- Images ------------------------------------------------------------------
# Base URL for flower photos served as static files from your VPS, e.g.
# https://img.yourflowershop.uz  — leave empty to use local /public placeholders.
NEXT_PUBLIC_IMAGE_BASE_URL=""

# Hostname (no protocol) allowed for Next.js Image optimization, e.g.
# img.yourflowershop.uz — must match the host in NEXT_PUBLIC_IMAGE_BASE_URL.
IMAGE_REMOTE_HOST=""
